<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ anchor_launch_agent_label }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ anchor_bin_dir | expanduser }}/anchord</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- KeepAlive restarts anchord if it exits. That restores the *service*,
         never the sessions a dead anchord was holding: the master fd has no
         handoff, so a restarted anchord is a clean daemon whose previous
         sessions are marked `lost` (anchor docs/07-lifecycle.md). Restart
         buys continuity of the service, not of the sessions. -->
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- Deliberately no socket argument: anchord resolves the same path a
         client resolves. A unit that pinned one would diverge from the
         client's resolution the moment either changed. -->
</dict>
</plist>
