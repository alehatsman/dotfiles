<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dex proxy — loopback Anthropic API pass-through (dex #235, epic #232).
  Mirrors the Linux user systemd unit (dex-proxy.service.j2) for macOS.

  DAEMON-ONLY / OPT-IN: this agent only *runs* the proxy. It does NOT set
  ANTHROPIC_BASE_URL anywhere — Claude sessions route through it only when
  a user/agent explicitly exports
    ANTHROPIC_BASE_URL=http://127.0.0.1:{{ dex_proxy_port }}
    ENABLE_TOOL_SEARCH=true
  Keeping it opt-in means the no-compression spike is never a single point
  of failure for the Mac's Claude sessions.

  Bound to 127.0.0.1 on purpose: the proxy sees the agent's API key.
  KeepAlive + ThrottleInterval=10 lets launchd restart without runaway loops.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alehatsman.dex-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/{{ username }}/.local/bin/dex</string>
    <string>proxy</string>
    <string>--addr</string>
    <string>127.0.0.1:{{ dex_proxy_port }}</string>
    <string>--tool-desc</string>
    <string>{{ dex_proxy_tool_desc }}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/dex-proxy.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dex-proxy.log</string>
</dict>
</plist>
