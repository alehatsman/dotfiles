# dex portfolio sweep — systemd user unit (single instance, server scope).
#
# Replaces eager per-project watchers (dex serve's eager-watch and the N
# resident dex-watch@ instances) with ONE polling daemon that keeps every repo
# dex has ever indexed fresh — not just the served dex_watch_paths. It walks the
# index dir and, for each known project that is stale (git HEAD newer than its
# index) and opted-in, runs an incremental `dex index`: one repo at a time,
# throttled, so it never starves the interactive embed/ask path on the shared
# GPU.
#
# Why a sweep instead of watchers: one resident fsnotify watcher per repo does
# not scale to the whole portfolio (inotify ceiling, N open stores) and misses
# cold repos changed outside any watched process (git pull, a repo not open in an
# editor). The sweep holds nothing resident and catches them on its interval.
#
# Per-repo opt-out: `sweep: {enabled: false}` in that repo's .dex/config.yml.

[Unit]
Description=dex portfolio sweep (keep all known repos fresh)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Embed-only: sweep runs `dex index`, which needs the EMBED endpoint only; the
# CHAT_*/RERANK_* vars in dex.env are inert here. Same single source as
# watch/serve/CLI so it can't drift. `%h` is systemd's user-home specifier;
# {{ dex_bin_path }} resolves to a tilde form systemd won't expand in ExecStart.
EnvironmentFile=%h/.config/dex/dex.env
# --interval: quiet window between full passes over the portfolio.
# --delay:    pause between repos within a pass (throttle vs interactive GPU load).
ExecStart=%h/.local/bin/dex sweep -v --interval {{ dex_sweep_interval | default:'15m' }} --delay {{ dex_sweep_delay | default:'10s' }}
Restart=always
RestartSec=30s

[Install]
WantedBy=default.target
