# dex runtime environment — SINGLE SOURCE OF TRUTH for the DEX_* vars.
# Rendered by components/dex (index.yml) from shared/variables.yml + machine
# overrides, then consumed verbatim by every sink that needs dex's endpoints:
#   - ~/.zshenv               (CLI / scripts / cron / agent shells — sourced)
#   - dex-serve.service       (EnvironmentFile=)
#   - dex-watch@.service      (EnvironmentFile=)
#   - `dex mcp` registration  (each line becomes a `claude mcp add -e` flag)
# Change a value via the vars and re-deploy — never edit the consumers.
# Format is KEY=VALUE (systemd EnvironmentFile + `set -a; . file`); no `export`,
# no quotes (values have no spaces). Do not hand-edit — mooncake overwrites it.
DEX_EMBED_URL=http://127.0.0.1:{{ dex_local_port }}
DEX_EMBED_MODEL={{ dex_embed_model }}
DEX_EMBED_BATCH={{ dex_embed_batch }}
DEX_CHAT_URL=http://127.0.0.1:{{ dex_local_port }}
DEX_CHAT_MODEL={{ dex_chat_model }}
DEX_ASK_MODEL={{ dex_ask_model }}
{% if dex_expand_model | default:'' %}
DEX_EXPAND_MODEL={{ dex_expand_model }}
DEX_EXPAND_MODE={{ dex_expand_mode | default:'on' }}
{% endif %}
{% if dex_rerank_local_port %}
DEX_RERANK_URL=http://{{ dex_rerank_connect_host | default:'127.0.0.1' }}:{{ dex_rerank_local_port }}
DEX_RERANK_STYLE={{ dex_rerank_style }}
DEX_RERANK_MODEL={{ dex_rerank_model }}
DEX_RERANK_POOL={{ dex_rerank_pool }}
DEX_RERANK_CONCURRENCY={{ dex_rerank_concurrency }}
{% endif %}
