[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  side-by-side = true
[user]
  name = {{ FULLNAME }}
  email = {{ EMAIL }}
  editor = nvim
[merge]
  tool = nvimdiff
  guitool = nvimdiff
  conflictstyle = diff3
[mergetool "nvimdiff"]
  trustExitCode = false
  prompt = false
[diff]
  guitool = nvimdiff
[difftool "nvimdiff"]
  trustExitCode = false
