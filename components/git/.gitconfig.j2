[core]
  pager = delta
  # Every hook name there is a symlink to hook-dispatch, which strips
  # assistant attribution trailers from commit messages and then hands off
  # to the repo's own hook. Absolute, because this setting replaces
  # .git/hooks everywhere and is not worth leaving to ~ expansion.
  hooksPath = {{ "~/.config/git/hooks" | expanduser }}
[interactive]
  diffFilter = delta --color-only
[delta]
  side-by-side = true
[user]
  name = {{ FULLNAME }}
  email = {{ EMAIL }}
  editor = nvim
[merge]
  tool = nvimdiff
  guitool = nvimdiff
  conflictstyle = diff3
[mergetool "nvimdiff"]
  trustExitCode = false
  prompt = false
[diff]
  guitool = nvimdiff
[difftool "nvimdiff"]
  trustExitCode = false
