# ~/.ssh/config — rendered by components/ssh from ssh_hosts in
# shared/variables.yml. Do not hand-edit.
{% for h in ssh_hosts %}
Host {{ h.name }}
    HostName {{ h.hostname }}{% if h.port is defined %}
    Port {{ h.port }}{% endif %}{% if h.user is defined %}
    User {{ h.user }}{% endif %}{% if h.tailnet_relay is defined %}{% if ssh_tailnet_relay_enabled == 'true' %}
    ProxyCommand ssh {{ h.tailnet_relay }} tailscale nc %h %p{% else %}
    ProxyCommand tailscale nc %h %p{% endif %}{% endif %}
{% endfor %}
