# ~/.zshenv — sourced by EVERY zsh (interactive, non-interactive, scripts,
# cron). Environment that must be present regardless of shell type lives here;
# interactive-only setup (prompt, plugins, aliases) stays in ~/.zshrc.
# Template-managed by components/zsh — single source of truth is
# shared/variables.yml. Do not hand-edit.

# Rust/cargo — guarded so a box without rustup doesn't error on every shell.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# dex — point ad-hoc CLI invocations at the same endpoints + models the MCP
# registration and the watch/serve units use. The DEX_* values live in ONE
# file rendered by components/dex (~/.config/dex/dex.env); we source it here so
# scripts, cron, agent tool-shells and `zsh -c` all get them too (otherwise a
# bare `dex` falls back to the binary's compiled defaults and dim-mismatches the
# index — dotfiles #33). Guarded so a box without dex (no file) is a no-op.
# `set -a` auto-exports every KEY=VALUE the file assigns.
if [ -f "$HOME/.config/dex/dex.env" ]; then
  set -a
  . "$HOME/.config/dex/dex.env"
  set +a
fi
{% if props.dex_proxy_default_on == "true" %}
# Route Claude sessions through the local dex proxy by default. Opt out for
# a single shell with `unset ANTHROPIC_BASE_URL` if the proxy is wedged.
export ANTHROPIC_BASE_URL=http://127.0.0.1:{{ props.dex_proxy_port }}
export ENABLE_TOOL_SEARCH=true
{% endif %}
