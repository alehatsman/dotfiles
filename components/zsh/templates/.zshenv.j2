# ~/.zshenv — sourced by EVERY zsh (interactive, non-interactive, scripts,
# cron, git hooks, agent PTYs). Template-managed by components/zsh — single
# source of truth is shared/variables.yml. Do not hand-edit.
#
# This file does one thing: source ~/.config/zsh/env.zsh, which holds the
# whole environment (PATH, locale, editor, tool roots). It used to carry an
# ordering-critical PATH *prefix* while ~/.zshrc carried the full list — two
# lists, and only the interactive one was complete. That split is gone; see
# env.zsh's own header for why it had to.
[ -r "$HOME/.config/zsh/env.zsh" ] && . "$HOME/.config/zsh/env.zsh"
