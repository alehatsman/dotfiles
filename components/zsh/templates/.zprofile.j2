# ~/.zprofile — login shells only, sourced AFTER /etc/zprofile.
# Template-managed by components/zsh — single source of truth is
# shared/variables.yml. Do not hand-edit.
#
# This file exists for exactly one reason, and it is a macOS one.
#
# /etc/zprofile runs /usr/libexec/path_helper, which does not append to PATH —
# it REBUILDS it: /etc/paths first, then /etc/paths.d/*, then whatever was
# already there, in that order. Measured, not assumed:
#
#     $ env PATH=/opt/homebrew/bin:/usr/bin /usr/libexec/path_helper -s
#     PATH="/usr/local/bin:...:/usr/bin:/bin:...:/opt/homebrew/bin"
#
# Homebrew went in first and came out last. So everything ~/.zshenv put in
# front is demoted behind Apple's /usr/bin on every login shell, and moving the
# entries into /etc/paths.d cannot win either — paths.d is always emitted after
# /etc/paths. Re-asserting after /etc/zprofile has run is the only point in the
# sequence that survives.
#
# Re-sourcing the same file ~/.zshenv already sourced, rather than restating a
# prefix here, is what keeps this from becoming a second list that drifts:
# env.zsh runs `typeset -U path PATH`, so the second pass moves existing
# entries to the front instead of duplicating them. On Linux there is no
# path_helper and nothing was demoted, which makes this a cheap no-op — kept
# uniform so the file means one thing on all five machines.
[ -r "$HOME/.config/zsh/env.zsh" ] && . "$HOME/.config/zsh/env.zsh"
