# Yank to the system clipboard (pbcopy on macOS, wl-copy on Wayland)
function vi-yank-xclip {
    zle vi-yank
    if [[ "$OSTYPE" == darwin* ]]; then
      printf '%s' "$CUTBUFFER" | pbcopy
    else
      printf '%s' "$CUTBUFFER" | wl-copy
    fi
}

