# npm / yarn

# search for file recursively up
{% raw %}
upsearch() {
  slashes=${PWD//[^\/]/}
  directory="$PWD"
  for (( n=${#slashes}; n>0; --n ))
  do
    test -e "$directory/$1" && echo "$directory/$1" && return
    directory="$directory/.."
  done
}
{% endraw %}

# fzf_npm_script - opens fzf for npm script
# selection. Prints selected script back
_fzf_npm_script() {
  if [[ ! -f './package.json' ]]; then
    echo "no package.json file!"
    return 0
  fi

  local npm_script
  npm_script=$(cat ./package.json | jq -r '.scripts | keys | .[]' | fzf)
  echo "$npm_script"
}

# Print the package manager this tree is locked to, and exit 0 when one was
# found. Both branches used to `return 1` on success and `return 0` on
# not-found; callers only ever tested the captured string, so it worked by
# accident and would have inverted under set -e or an && chain (dotfiles#76).
_get_npm_client() {
  if [[ $(upsearch 'yarn.lock') ]]; then
    echo 'yarn'
    return 0
  fi

  if [[ $(upsearch 'package-lock.json') ]]; then
    echo 'npm'
    return 0
  fi

  return 1
}

# nr - npm run script
# Opens fzf with list of available scripts
# runs selected script
nr() {
  local npm_client
  npm_client=$(_get_npm_client)
  if [ -z "$npm_client" ]; then
    echo "no package-lock.json or yarn.lock - using npm"
    npm_client='npm'
  fi

  local npm_script
  npm_script=$(_fzf_npm_script)
  if [ -z "$npm_script" ]; then
    return 0
  fi
  echo "$npm_client run $npm_script"
  "$npm_client" run "$npm_script"
}

ni() {
  local npm_client
  npm_client=$(_get_npm_client)
  if [ -z "$npm_client" ]; then
    # Match nr's behaviour: a package.json with no lockfile yet is the normal
    # state of a fresh project, and doing nothing there looked like success.
    echo "no package-lock.json or yarn.lock - using npm"
    npm_client='npm'
  fi

  echo "$npm_client" install
  "$npm_client" install
}

npm_uninstall_globals() {
  npm ls -gp --depth=0 | awk -F/ '/node_modules/ && !/\/npm$/ {print $NF}' | xargs npm -g rm
}

