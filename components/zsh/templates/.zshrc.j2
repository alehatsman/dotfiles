# Two layouts, one guard. Homebrew (mac) ships fzf's shell integration in a
# shell/ subdir; both Linux packagings put the same two files flat under
# FZF_BASE — Arch's pacman in /usr/share/fzf, Debian/Ubuntu's apt in
# /usr/share/doc/fzf/examples. FZF_BASE comes from the per-distro vars file
# (components/zsh/vars/), so the flat branch covers both (dotfiles#72).
if [[ -f $FZF_BASE/shell/key-bindings.zsh ]]; then
  source $FZF_BASE/shell/key-bindings.zsh
  source $FZF_BASE/shell/completion.zsh
