# Worktree helpers — layout: ~/worktrees/<repo>/<branch>, outside the repo.
# This is the convention CLAUDE.md mandates, so agents and humans land in the
# same checkout. It replaced a sibling layout (../<repo>-<name>) that put
# worktrees next to the repo and, for a conventional branch name containing a
# slash, produced paths like ~/dotfiles-fix/foo. See dotfiles#85.
_gw_root() { git rev-parse --show-toplevel 2>/dev/null }

# The MAIN repo's root, stable from inside any linked worktree. --show-toplevel
# returns the *current* worktree, so deriving the repo name from it made every
# helper misbehave once you were standing in a worktree; the common git dir is
# shared by all of them.
_gw_main_root() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ -n "$common" ]] || return 1
  print -r -- "${common:h}"
}

_gw_path() {
  local main
  main=$(_gw_main_root) || return 1
  print -r -- "$HOME/worktrees/${main:t}/$1"
}

# Remove the now-empty parent dirs a nested branch name left behind
# (~/worktrees/dotfiles/fix/ after deleting fix/85-foo), stopping at
# ~/worktrees/<repo>. rmdir only ever removes empty directories, and the loop
# stops at the first non-empty one, so a sibling worktree is never touched.
_gw_prune_dirs() {
  local dir="${1:h}" main stop
  main=$(_gw_main_root) || return 0
  stop="$HOME/worktrees/${main:t}"
  # The pattern excludes $stop itself, so ~/worktrees/<repo> always survives.
  while [[ "$dir" == "$stop"/* ]]; do
    rmdir "$dir" 2>/dev/null || break
    dir="${dir:h}"
  done
}

_gw_default() {
  local ref
  ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -n "$ref" ]]; then echo "${ref#refs/remotes/origin/}"; return; fi
  for b in master main; do
    git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }
  done
}

# moongit — derive <owner>/<repo> from a checkout's origin (github), used to
# build the `moongit` mirror remote URL.
_moongit_owner_repo() {
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  url=${url%.git}
  case "$url" in
    *://*) url=${url#*://}; url=${url#*/} ;;  # http(s)://host/owner/repo
    *:*)   url=${url#*:} ;;                   # git@host:owner/repo
  esac
  [[ "$url" == */* ]] || return 1
  print -r -- "$url"
}

# moongit — add the `moongit` mirror remote + dual push-url to a worktree so
# `git push` also lands on the moongit server (and mgit can resolve the repo
# from it). Identity is NOT handled here — see the `ce` launcher. No-op where
# the repo has no origin / moongit isn't configured.
_moongit_worktree_setup() {
  local wt="$1" gd owner_repo mg_url origin_fetch
  gd=$(git -C "$wt" rev-parse --git-dir 2>/dev/null) || return 0
  # Ensure a `moongit` mirror remote (shared across a repo's worktrees).
  if ! git -C "$wt" remote get-url moongit >/dev/null 2>&1; then
    owner_repo=$(_moongit_owner_repo "$wt") \
      && git -C "$wt" remote add moongit \
           "${MOONGIT_SERVER:-http://127.0.0.1:8080}/${owner_repo}.git"
  fi
  # Mirror code on push: make `git push origin` also hit moongit. Adding any
  # pushurl drops the implicit one, so pin the github fetch url first, then
  # add moongit. Idempotent on the moongit pushurl.
  mg_url=$(git -C "$wt" remote get-url moongit 2>/dev/null)
  origin_fetch=$(git -C "$wt" remote get-url origin 2>/dev/null)
  if [[ -n "$mg_url" ]] \
     && ! git -C "$wt" config --get-all remote.origin.pushurl 2>/dev/null | grep -qxF "$mg_url"; then
    git -C "$wt" config --get-all remote.origin.pushurl >/dev/null 2>&1 \
      || { [[ -n "$origin_fetch" ]] && git -C "$wt" remote set-url --add --push origin "$origin_fetch" }
    git -C "$wt" remote set-url --add --push origin "$mg_url"
  fi
}

# NB: never name a local `path` — zsh aliases it to the PATH array, so
# `local path` clears PATH for the function scope and every external
# command (git, etc.) fails with command-not-found.
gwc() { # git worktree create: gwc <name> [base]
  [[ $# -lt 1 ]] && { echo "usage: gwc <name> [base]" >&2; return 1 }
  local name="$1" base="${2:-$(_gw_default)}" wt
  _gw_root >/dev/null || { echo "not in a git repo" >&2; return 1 }
  wt=$(_gw_path "$name") || { echo "cannot resolve repo root" >&2; return 1 }
  [[ -e "$wt" ]] && { echo "path exists: $wt" >&2; return 1 }
  # A conventional branch name (fix/85-foo) nests under the repo dir, so the
  # parent may not exist yet.
  mkdir -p "${wt:h}" || return 1
  git fetch origin "$base" --quiet 2>/dev/null
  # On any failure, take the parent dirs just created back out — otherwise a
  # failed add (a colliding ref, say) leaves empty scaffolding behind.
  if git show-ref --verify --quiet "refs/heads/$name"; then
    git worktree add "$wt" "$name" || { _gw_prune_dirs "$wt"; return 1 }
  else
    git worktree add -b "$name" "$wt" "origin/$base" 2>/dev/null \
      || git worktree add -b "$name" "$wt" "$base" \
      || { _gw_prune_dirs "$wt"; return 1 }
  fi
  cd "$wt"
  _moongit_worktree_setup "$wt"
}

gwd() { # git worktree delete (safe): gwd <name>
  [[ $# -lt 1 ]] && { echo "usage: gwd <name>" >&2; return 1 }
  local name="$1" root wt
  # The MAIN root, not _gw_root: when you run this from inside the worktree
  # being deleted, _gw_root is that worktree, so the `cd` below would land in
  # the directory git is about to remove and the removal would fail.
  root=$(_gw_main_root) || { echo "not in a git repo" >&2; return 1 }
  wt=$(_gw_path "$name") || return 1
  [[ -d "$wt" ]] || { echo "no worktree at $wt" >&2; return 1 }

  if ! git -C "$wt" diff --quiet || ! git -C "$wt" diff --cached --quiet; then
    echo "uncommitted changes in $wt — commit/stash or use gwd! $name" >&2
    return 1
  fi
  local upstream ahead
  upstream=$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
  if [[ -n "$upstream" ]]; then
    ahead=$(git -C "$wt" rev-list --count "$upstream..HEAD" 2>/dev/null)
    if [[ "${ahead:-0}" -gt 0 ]]; then
      echo "$name is $ahead ahead of $upstream — push or use gwd! $name" >&2
      return 1
    fi
  else
    ahead=$(git -C "$wt" rev-list --count "$name" "^$(_gw_default)" 2>/dev/null)
    if [[ "${ahead:-0}" -gt 0 ]]; then
      echo "$name has $ahead local commits with no upstream — push or use gwd! $name" >&2
      return 1
    fi
  fi

  [[ "$PWD/" == "$wt/"* ]] && cd "$root"
  git worktree remove "$wt" || return 1
  _gw_prune_dirs "$wt"
  git branch -d "$name"
  git ls-remote --exit-code --heads origin "$name" >/dev/null 2>&1 \
    && git push origin --delete "$name"
}

gwd!() { # git worktree delete force: gwd! <name>
  [[ $# -lt 1 ]] && { echo "usage: gwd! <name>" >&2; return 1 }
  local name="$1" root wt
  root=$(_gw_main_root) || { echo "not in a git repo" >&2; return 1 }
  wt=$(_gw_path "$name") || return 1
  [[ "$PWD/" == "$wt/"* ]] && cd "$root"
  [[ -d "$wt" ]] && git worktree remove --force "$wt"
  _gw_prune_dirs "$wt"
  git branch -D "$name" 2>/dev/null
  git ls-remote --exit-code --heads origin "$name" >/dev/null 2>&1 \
    && git push origin --delete --force "$name"
}

alias gwl="git worktree list"

fgw() { # fzf-pick a worktree and cd
  local sel
  sel=$(git worktree list | fzf-tmux --height 40% +m) || return
  cd "$(echo "$sel" | awk '{print $1}')"
}

_gw_complete_worktrees() {
  local root names
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return
  names=("${(@f)$(git worktree list --porcelain 2>/dev/null | awk -v main="$root" '
    /^worktree / { wt = $2 }
    /^branch refs\/heads\// {
      if (wt != main) { sub(/^branch refs\/heads\//, ""); print }
    }')}")
  _describe 'worktree' names
}
compdef _gw_complete_worktrees gwd
compdef _gw_complete_worktrees 'gwd!'

fgcb() {
  local branches branch
  branches=$(git branch --all | rg -v HEAD) &&
  branch=$(echo "$branches" |
           fzf-tmux --height 40% -d $(( 2 + $(wc -l <<< "$branches") )) +m) &&
  git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
}

# 1Password — fzf-pick an item, copy its password to the clipboard.
# Assumes `op` is already authenticated (desktop-app integration on both
# mac and Linux handles the biometric/session unlock).
fop() {
  local item pw
  item=$(op item list --format=json | jq -r '.[].title' | fzf) || return
  pw=$(op item get "$item" --fields label=password --reveal) || return
  if [[ "$OSTYPE" == darwin* ]]; then
    printf '%s' "$pw" | pbcopy
  else
    printf '%s' "$pw" | wl-copy
  fi
}

# fzf-pick one or more processes and signal them. Default signal is 9;
# pass another as $1 (e.g. `fkill 15`).
#
# The awk program MUST stay single-quoted: in double quotes zsh expands $2
# itself (to the function's empty second positional), awk receives "{print }"
# and prints the whole ps line — so kill got UID, PPID, times and command
# words instead of a PID. See dotfiles#75.
fkill() {
  local pids
  if [ "$UID" != "0" ]; then
      pids=$(ps -f -u "$UID" | sed 1d | fzf -m | awk '{print $2}')
  else
      pids=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')
  fi

  # Nothing selected (Esc) is a no-op, and only numeric fields ever reach
  # kill — a belt-and-braces guard against the class of bug above.
  [ -n "$pids" ] || return 0
  print -r -- "$pids" | grep -E '^[0-9]+$' | xargs -r kill "-${1:-9}"
}

tm() {
