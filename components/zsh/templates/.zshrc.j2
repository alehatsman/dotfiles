# Make Esc-to-vicmd feel instant and show the current mode via cursor shape.
KEYTIMEOUT=1
function zle-keymap-select {
  case $KEYMAP in
    vicmd)      printf '\e[2 q' ;;  # block — normal mode
    main|viins) printf '\e[6 q' ;;  # bar   — insert mode
  esac
}
zle -N zle-keymap-select
