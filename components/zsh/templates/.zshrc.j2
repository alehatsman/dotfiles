# Launch Claude with a fresh moongit identity.
ce() {
  if command -v moongitd >/dev/null; then
    [[ -r ~/.config/moongit/agent.env ]] &&
      source ~/.config/moongit/agent.env

    local seqfile="$HOME/.config/moongit/agent-seq"
    local n ident token

    mkdir -p "${seqfile:h}"

    repeat 5; do
      n=$(( ${$(<"$seqfile" 2>/dev/null):-0} + 1 ))
      print -r -- "$n" >| "$seqfile"

      ident="agent#$n"
      token=$(
        moongitd token create "$ident" 2>/dev/null |
          grep -om1 'mgt_[0-9a-f]\+'
      )

      [[ -n "$token" ]] && break
    done

    if [[ -n "$token" ]]; then
      export MOONGIT_TOKEN="$token"
      print -u2 -- "moongit identity: $ident"
    fi
  fi

  cry-aye "$@"
}
