# ~/.config/zsh/env.zsh — the environment, for every kind of zsh.
# Template-managed by components/zsh — single source of truth is
# shared/variables.yml. Do not hand-edit.
#
# Sourced by ~/.zshenv (so it reaches non-interactive shells: scripts, cron,
# git hooks, provision's own `shell` steps, agent PTYs) and again by
# ~/.zprofile (so it survives macOS's path_helper — see that file for the
# measurement). `typeset -U path PATH` makes the second pass move entries
# rather than duplicate them, so sourcing twice is idempotent by construction.
#
# Why this file exists at all: PATH and these exports used to live in
# ~/.zshrc, which zsh sources for INTERACTIVE shells only. That made "which
# binary does a tool get" depend on whether a human happened to be typing.
# The case that finally forced it: teleportd runs as a launchd/systemd
# service and spawns `claude`/`codex` with no shell in between, so an agent
# session got the service manager's bare environment — no Homebrew, no
# EDITOR, no LANG. The workaround was a hand-mirrored copy of this PATH
# inside components/teleport's LaunchAgent plist; that copy is gone, and this
# file is the one owner now (alehatsman/teleport docs/03-pty-layer.md#spawn).
#
# What stays in ~/.zshrc: anything that is only meaningful with a human at a
# terminal — GPG_TTY (and its $(tty) subprocess), zplug, fzf key bindings,
# prompt, aliases, completion.

# Rust/cargo — guarded so a box without rustup doesn't error on every shell.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# ── Locale and editor ────────────────────────────────────────────────────────
export LANG=en_US.UTF-8
export VISUAL="nvim"
export EDITOR="nvim"

# ── Tool roots ───────────────────────────────────────────────────────────────
export NODE_MODULES_BIN=./node_modules/.bin
export GCPATH={{ GCP_PATH }}
export JAVA_HOME={{ JAVA_HOME }}
export CARGO_HOME=~/.cargo
export NVIDIA_GIT_BASE=~/projects/nvidia/git-helpers
export SSH_KEY_PATH=~/.ssh/id_ed25519

# GUI sudo prompt for non-TTY contexts (editor terminals, sudo -A). Only set
# when the helper actually exists — it's deployed by the hyprland entry (needs
# wofi), so non-Hyprland Linux boxes (WSL, headless) skip it.
if [[ -x "$HOME/.local/bin/gui-askpass" ]]; then
  export SUDO_ASKPASS=$HOME/.local/bin/gui-askpass
fi

# codefort — agent.env exports CODEFORT_SERVER + CODEFORT_DATA_DIR (and a
# baseline CODEFORT_TOKEN for ad-hoc cf). Here rather than in ~/.zshrc so a
# teleport-spawned agent inherits it too; per-agent identity is still minted
# by the `ce` launcher in ~/.zshrc, which is interactive-only on purpose.
[[ -r ~/.config/codefort/agent.env ]] && source ~/.config/codefort/agent.env

# ── PATH ─────────────────────────────────────────────────────────────────────
# One list, one owner. `typeset -U` ties $path to $PATH and drops duplicates on
# assignment, so re-sourcing moves an entry instead of growing PATH unbounded.
#
# No $FZF_BASE/bin: fzf installs no bin/ subdir under any of the three prefixes
# (apt's examples dir, pacman's /usr/share/fzf, Homebrew's opt path), so it only
# ever added a nonexistent entry (dotfiles#72).
#
# $NODE_MODULES_BIN is a RELATIVE entry (./node_modules/.bin) and now applies to
# non-interactive shells as well as interactive ones. That is deliberate — an
# agent session should resolve a repo's local toolchain exactly the way the
# terminal does — but it does mean a cloned repo can place an executable on the
# PATH of a script run inside it. Same exposure interactive shells already had.
typeset -U path PATH
export PATH=$HOME/bin:$HOME/.local/bin:$HOME/.npm-global/bin:/opt/local/bin:/opt/homebrew/bin:$PATH:$NVIDIA_GIT_BASE/bin:$JAVA_HOME/bin:$GCPATH/bin:$HOME/go/bin:$NODE_MODULES_BIN:$CARGO_HOME/bin
{% if os == 'darwin' %}
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
{% endif %}
